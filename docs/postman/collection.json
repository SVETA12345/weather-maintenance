                  "pm.test('Созданная заявка содержит id и priority=high', () => {",
                  "    pm.expect(body.data.id).to.be.a('string');",
                  "    pm.expect(body.data.equipmentId).to.eql(pm.collectionVariables.get('equipmentId'));",
                  "    pm.expect(body.data.priority).to.eql('high');",
