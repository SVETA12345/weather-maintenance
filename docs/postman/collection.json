{
  "info": {
    "name": "weather-maintenance-api",
    "description": "REST API для планирования технического обслуживания оборудования с учётом погоды.\n\nОпределите переменную окружения Postman `baseUrl`, например `http://localhost:3000`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Получить статус сервиса",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"]
            },
            "description": "Проверка доступности сервиса."
          }
        }
      ]
    },
    {
      "name": "Оборудование",
      "item": [
        {
          "name": "Список оборудования",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/equipment?page=1&pageSize=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "equipment"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Создать оборудование",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Трансформатор ТП-12\",\n  \"type\": \"transformer\",\n  \"location\": {\n    \"latitude\": 55.7558,\n    \"longitude\": 37.6173,\n    \"city\": \"Москва\"\n  },\n  \"criticality\": \"high\",\n  \"installationDate\": \"2020-06-15\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/equipment",
              "host": ["{{baseUrl}}"],
              "path": ["api", "equipment"]
            }
          }
        },
        {
          "name": "Оборудование по id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/equipment/eq_placeholder",
              "host": ["{{baseUrl}}"],
              "path": ["api", "equipment", ":id"],
              "variable": [{ "key": "id", "value": "eq_placeholder" }]
            }
          }
        },
        {
          "name": "Обновить оборудование",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"maintenance\",\n  \"criticality\": \"medium\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/equipment/eq_placeholder",
              "host": ["{{baseUrl}}"],
              "path": ["api", "equipment", ":id"],
              "variable": [{ "key": "id", "value": "eq_placeholder" }]
            }
          }
        },
        {
          "name": "Удалить оборудование",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/equipment/eq_placeholder",
              "host": ["{{baseUrl}}"],
              "path": ["api", "equipment", ":id"],
              "variable": [{ "key": "id", "value": "eq_placeholder" }]
            }
          }
        }
      ]
    },
    {
      "name": "Заявки на обслуживание",
      "item": [
        {
          "name": "Список заявок",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/requests?status=pending",
              "host": ["{{baseUrl}}"],
              "path": ["api", "requests"],
              "query": [{ "key": "status", "value": "pending" }]
            }
          }
        },
        {
          "name": "Создать заявку (приоритет из погоды)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"equipmentId\": \"eq_placeholder\",\n  \"type\": \"preventive\",\n  \"scheduledDate\": \"2026-09-25\",\n  \"notes\": \"Плановое ТО перед сезоном дождей\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/requests",
              "host": ["{{baseUrl}}"],
              "path": ["api", "requests"]
            },
            "description": "Если priority не передан, он рассчитывается из текущей погоды в точке установки оборудования."
          }
        },
        {
          "name": "Заявка по id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/requests/req_placeholder",
              "host": ["{{baseUrl}}"],
              "path": ["api", "requests", ":id"],
              "variable": [{ "key": "id", "value": "req_placeholder" }]
            }
          }
        },
        {
          "name": "Обновить заявку",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"in_progress\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/requests/req_placeholder",
              "host": ["{{baseUrl}}"],
              "path": ["api", "requests", ":id"],
              "variable": [{ "key": "id", "value": "req_placeholder" }]
            }
          }
        },
        {
          "name": "Завершить заявку",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/requests/req_placeholder/complete",
              "host": ["{{baseUrl}}"],
              "path": ["api", "requests", ":id", "complete"],
              "variable": [{ "key": "id", "value": "req_placeholder" }]
            }
          }
        }
      ]
    },
    {
      "name": "Погода",
      "item": [
        {
          "name": "Погода по координатам",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/weather?latitude=55.7558&longitude=37.6173",
              "host": ["{{baseUrl}}"],
              "path": ["api", "weather"],
              "query": [
                { "key": "latitude", "value": "55.7558" },
                { "key": "longitude", "value": "37.6173" }
              ]
            }
          }
        },
        {
          "name": "Погода для оборудования",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/weather/equipment/eq_placeholder",
              "host": ["{{baseUrl}}"],
              "path": ["api", "weather", "equipment", ":id"],
              "variable": [{ "key": "id", "value": "eq_placeholder" }]
            }
          }
        }
      ]
    }
  ]
}