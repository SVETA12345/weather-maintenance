          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"new\"\n}" },
            "url": {
              "raw": "{{baseUrl}}/api/requests/{{requestId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "requests", ":id", "status"],
              "variable": [{ "key": "id", "value": "{{requestId}}" }]
            },
            "description": "Заявка уже переведена в done выше, переход done → new запрещён."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('Статус 409', () => pm.expect(pm.response.code).to.eql(409));",
                  "pm.test('Код INVALID_STATUS_TRANSITION', () => pm.expect(body.error.code).to.eql('INVALID_STATUS_TRANSITION'));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "6. Rate limit",
      "item": [
        {
          "name": "Превышение лимита частоты (429)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/equipment", "host": ["{{baseUrl}}"], "path": ["api", "equipment"] },
            "description": "Pre-request исчерпывает лимит запросов (окно по умолчанию 100/15 мин), после чего сам запрос должен вернуть 429 RATE_LIMIT_EXCEEDED."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Исчерпываем rate-limit, чтобы следующий запрос гарантированно получил 429.",
                  "const url = pm.collectionVariables.get('baseUrl') + '/api/health';",
                  "const TOTAL = 105;",
                  "let sent = 0;",
                  "const burst = () => {",
                  "    if (sent >= TOTAL) return;",
                  "    sent++;",
                  "    pm.sendRequest(url, () => burst());",
                  "};",
                  "burst();"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('Статус 429', () => pm.expect(pm.response.code).to.eql(429));",
                  "pm.test('Код RATE_LIMIT_EXCEEDED', () => {",
                  "    pm.expect(body.error.code).to.eql('RATE_LIMIT_EXCEEDED');",
                  "    pm.expect(body.error).to.have.property('requestId');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    }
  ]
}