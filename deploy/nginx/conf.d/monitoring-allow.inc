# Кому разрешён доступ к метрикам и интерфейсу мониторинга.
#
# Используется в location = /metrics основного сервера и на всех monitoring-серверах.
# Правила проверяются по $remote_addr — реальному адрету соединения, подделать его
# клиент не может (заголовки X-Forwarded-* из входящего запроса не учитываются).
#
# Список по умолчанию: сам рабочий компьютер и приватные сети. В Docker Desktop
# запросы к published-порту приходят с адреса docker-шлюза (обычно 172.x), поэтому
# 172.16.0.0/12 включён — иначе локальный доступ к UI перестал бы работать.
#
# Для внешнего доступа (например, Grafana с другого сервера) добавьте конкретный
# адрес или подсеть выше строки deny all. Держать /24 приватной сети здесь не стоит:
# правило проверяет источник, а не доверие к сети.
allow 127.0.0.1;
allow ::1;
allow 10.0.0.0/8;
allow 172.16.0.0/12;
allow 192.168.0.0/16;
deny  all;