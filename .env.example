PORT=3000
NODE_ENV=development

# Обратный прокси. NGINX_PORT - порт, на котором прокси отдаёт приложение,
# документацию и статику по HTTP; по нему же идёт редирект на HTTPS.
# NGINX_HTTPS_PORT - порт HTTPS (https://localhost:8443). Значение повторяется
# в редиректе в deploy/nginx/conf.d/app.conf, меняешь одно - меняй и другое.
NGINX_PORT=8080
NGINX_HTTPS_PORT=8443

# Доверие обратному прокси. Приложение берёт реальный IP клиента из
# X-Real-IP / X-Forwarded-For только при включённом доверии: без него rate limit
# и логи видят адрес прокси и считают всех клиентов одним.
# 1 - доверять одному хопу (nginx во внутренней сети compose), loopback - только
# localhost, true - любому адресу (небезопасно, если приложение доступно извне).
# В compose значение по умолчанию 1; при запуске приложения напрямую (npm start)
# оставьте переменную пустой, иначе клиент сможет подделать свой IP.
TRUST_PROXY=""  
CORS_ORIGINS=http://localhost:5173,http://localhost:3001
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
GEOCODING_API_URL=https://geocoding-api.open-meteo.com/v1/search
REQUEST_TIMEOUT_MS=5000
REPORTS_DIR=./reports
WIND_THRESHOLD_MS=12
LOG_LEVEL=info

JWT_SECRET=replace-with-random-32-bytes-hex
JWT_REFRESH_SECRET=replace-with-another-random-32-bytes-hex
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_MS=604800000
BCRYPT_ROUNDS=12
REFRESH_COOKIE_NAME=refresh_token
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
SEED_ADMIN_PASSWORD=admin-demo-2026
SEED_TECH_PASSWORD=tech-demo-2026
SEED_VIEWER_PASSWORD=viewer-demo-2026

# DB_PORT — порт, который занимает БД на ХОСТЕ (compose публикует его наружу).
# Если на машине уже запущен свой PostgreSQL на 5432, поставьте свободный порт
# (например 5434): иначе контейнер БД не сможет занять порт, а хостовые команды
# миграций (`npx sequelize-cli db:migrate`) будут обращаться к чужому серверу.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=maintenance
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_MAX=10

# Проверки состояния. /api/health/ready отвечает 503, если БД недоступна
# дольше HEALTH_DB_TIMEOUT_MS или сервис завершает работу.
HEALTH_DB_TIMEOUT_MS=2000
# Предел ожидания при остановке; после него процесс завершается принудительно.
SHUTDOWN_TIMEOUT_MS=10000

# Метрики Prometheus (GET /metrics).
METRICS_COLLECT_DEFAULT=true
METRICS_APPLIED_TOP_N=20
METRICS_CACHE_MS=5000

# Интерактивная документация OpenAPI (GET /api/docs).
DOCS_ENABLED=true
DOCS_REQUIRE_AUTH=false

# Мониторинг. Наружу эти порты публикует только nginx, и доступ к UI ограничен
# списком адресов в deploy/nginx/conf.d/monitoring-allow.inc.
# Prometheus -> PROMETHEUS_PORT, Grafana -> GRAFANA_PORT, Alertmanager -> ALERTMANAGER_PORT.
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
PROMETHEUS_RETENTION=15d

# Оповещения Alertmanager. Значения подставляются в шаблон
# monitoring/alertmanager/alertmanager.yml при старте контейнера. Без заполненного
# SMTP правила срабатывают и видны в Prometheus и Grafana, но письма не отправляются.
# Почтовые оповещения Alertmanager. Учётные данные SMTP держите в .env (он в .gitignore),
# здесь только пример. Для Mail.ru: порт 587 и STARTTLS (require_tls=true);
# порт 465 - неявный TLS, Alertmanager его не поддерживает.
ALERT_EMAIL_TO=ops@example.com
ALERT_EMAIL_FROM=alerts@example.com
ALERT_SMTP_HOST=localhost
ALERT_SMTP_PORT=25
ALERT_SMTP_USER=alerts
ALERT_SMTP_PASSWORD=alerts
ALERT_SMTP_REQUIRE_TLS=false